# Copy to .env and fill in values. .env is gitignored.

# Firecrawl — used by backfill scripts to scrape club websites + FB pages.
# Multi-key rotation is built into src/firecrawl.py; provide comma-separated
# keys here and the runtime will round-robin across them as credits drain.
FIRECRAWL_API_KEYS=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxx,fc-yyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Legacy single-key fallback (only used if FIRECRAWL_API_KEYS is empty)
FIRECRAWL_API_KEY=

# Google Maps Platform — used by scripts/27_google_geocode.py for the
# cross-source coordinate check. Enable Places API (text search) and
# Geocoding API on the same key.
GOOGLE_MAPS_API_KEY=AIzaXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nominatim endpoint — defaults to the public SaaS at nominatim.openstreetmap.org.
# Set to your local Docker container for unrestricted geocoding throughput.
# See docker/nominatim/ for the HR PBF setup.
# NOMINATIM_ENDPOINT=http://localhost:8080

# Cloudflare — only needed when running frontend/scripts/deploy.sh.
# Account ID is the D.O.M. account; wrangler must be logged in via OAuth.
CLOUDFLARE_ACCOUNT_ID=7dc7167b7e2e00923bfa7cd697df14e4
